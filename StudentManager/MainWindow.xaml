<Window
    x:Class="StudentManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Student Management System"
    Width="1200"
    Height="750"
    Background="#F4F6FA"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BorderBrush" Value="#E0E4EC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,4"/>
            <Setter Property="Foreground" Value="#455A64"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="InputStyle" TargetType="Control">
            <Setter Property="Padding" Value="8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border
            Grid.Row="0"
            Background="#1565C0"
            CornerRadius="10"
            Padding="20"
            Margin="0,0,0,15">
            <StackPanel>
                <TextBlock
                    Text="STUDENT MANAGEMENT SYSTEM"
                    Foreground="White"
                    FontSize="28"
                    FontWeight="Bold"/>
                <TextBlock
                    Text="Manage student data"
                    Foreground="White"
                    FontSize="14"
                    Opacity="0.85"/>
            </StackPanel>
        </Border>

        <!-- FORM INPUT + INFORMASI -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Form -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="INPUT MAHASISWA" FontSize="20" FontWeight="Bold"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="NIM" Style="{StaticResource LabelStyle}"/>
                            <TextBox Style="{StaticResource InputStyle}"
                                     Text="{Binding FormStudent.NIM, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Jurusan" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Style="{StaticResource InputStyle}"
                                      ItemsSource="{Binding JurusanList}"
                                      SelectedItem="{Binding FormStudent.Jurusan}"/>

                            <TextBlock Text="Email" Style="{StaticResource LabelStyle}"/>
                            <TextBox Style="{StaticResource InputStyle}"
                                     Text="{Binding FormStudent.Email, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Nama" Style="{StaticResource LabelStyle}"/>
                            <TextBox Style="{StaticResource InputStyle}"
                                     Text="{Binding FormStudent.Nama, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Gender" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Style="{StaticResource InputStyle}"
                                      ItemsSource="{Binding GenderList}"
                                      SelectedItem="{Binding FormStudent.Gender}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Content="Simpan"
                                Command="{Binding SaveCommand}"
                                Background="#1976D2"
                                Foreground="White"
                                Padding="20,10"
                                Margin="0,0,10,0"/>
                        <Button Content="Hapus"
                                Command="{Binding DeleteCommand}"
                                Background="#D32F2F"
                                Foreground="White"
                                Padding="20,10"
                                Margin="0,0,10,0"/>
                        <Button Content="Reset"
                                Command="{Binding ResetCommand}"
                                Padding="20,10"/>
                    </StackPanel>

                    <TextBlock Text="{Binding StatusMessage}"
                               Margin="0,12,0,0"
                               Foreground="#1565C0"/>
                </StackPanel>
            </Border>

            <!-- Informasi -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="INFORMASI" FontSize="20" FontWeight="Bold"/>

                    <TextBlock Text="Total Mahasiswa" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding TotalStudents}"
                               FontSize="32" FontWeight="Bold" Foreground="#1565C0"/>

                    <UniformGrid Columns="2" Margin="0,10,0,0">
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Informatika" Foreground="#455A64"/>
                            <TextBlock Text="{Binding TotalInformatika}" FontSize="24"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Sistem Informasi" Foreground="#455A64"/>
                            <TextBlock Text="{Binding TotalSistemInformasi}" FontSize="24"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Laki-laki" Foreground="#455A64"/>
                            <TextBlock Text="{Binding TotalLakiLaki}" FontSize="24"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Perempuan" Foreground="#455A64"/>
                            <TextBlock Text="{Binding TotalPerempuan}" FontSize="24"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- SEARCH -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,15" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10"
                         ToolTip="Cari berdasarkan NIM, Nama, atau Jurusan"/>
                <Button Grid.Column="1"
                        Content="Cari"
                        Command="{Binding SearchCommand}"
                        Padding="25,10"
                        Margin="10,0,0,0"/>
            </Grid>
        </Border>

        <!-- DATAGRID -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="10">
            <DataGrid
                ItemsSource="{Binding Students}"
                SelectedItem="{Binding SelectedStudent, Mode=TwoWay}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                SelectionMode="Single"
                CanUserAddRows="False"
                AlternatingRowBackground="#F7F9FC"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NIM" Binding="{Binding NIM}" Width="*"/>
                    <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="2*"/>
                    <DataGridTextColumn Header="Jurusan" Binding="{Binding Jurusan}" Width="*"/>
                    <DataGridTextColumn Header="Gender" Binding="{Binding Gender}" Width="*"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
